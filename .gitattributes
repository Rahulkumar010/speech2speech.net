* text=auto

*.cs     text diff=csharp
*.csproj text
*.props  text
*.sln    text eol=crlf
*.ps1    text eol=crlf

# Model weights are large binaries that do not delta-compress. New ones go through Git LFS.
*.onnx filter=lfs diff=lfs merge=lfs -text
*.gguf filter=lfs diff=lfs merge=lfs -text
*.ggml filter=lfs diff=lfs merge=lfs -text
*.bin  filter=lfs diff=lfs merge=lfs -text
